{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "storyboard",
  "description": "Per-scene keyframes reviewed before any motion is generated (product-ad pipeline). Approved start/end frames drive image_to_video in storyboard_animate.",
  "type": "object",
  "required": ["version", "frames"],
  "properties": {
    "version": { "type": "string" },
    "aspect_ratio": { "type": "string" },
    "identity_references": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Project-relative product images used as identity references."
    },
    "reference_note": {
      "type": "string",
      "description": "How to read the references, e.g. 'one image showing six angles of the same product'."
    },
    "frames": {
      "type": "array",
      "items": { "$ref": "#/$defs/frame" }
    },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "image": {
      "type": "object",
      "required": ["path", "source"],
      "properties": {
        "path": { "type": "string" },
        "source": { "enum": ["generated", "provided"] },
        "prompt": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "source_tool": { "type": "string" }
      }
    },
    "clip": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "prompt": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "source_tool": { "type": "string" },
        "duration_seconds": { "type": "number" },
        "used_end_frame": { "type": "boolean" },
        "cost_usd": { "type": "number" }
      }
    },
    "take": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "kind": { "enum": ["start_frame", "end_frame", "clip"] },
        "rejected_reason": { "type": "string" }
      }
    },
    "frame": {
      "type": "object",
      "required": ["scene_id", "control", "start_frame", "status"],
      "properties": {
        "scene_id": { "type": "string" },
        "control": { "enum": ["image_to_video", "first_last_frame", "packshot_still"] },
        "start_frame": { "$ref": "#/$defs/image" },
        "end_frame": {
          "oneOf": [{ "$ref": "#/$defs/image" }, { "type": "null" }]
        },
        "status": { "enum": ["draft", "approved", "rejected"] },
        "notes": { "type": "string" },
        "takes": {
          "type": "array",
          "items": { "$ref": "#/$defs/take" }
        },
        "clip": {
          "oneOf": [{ "$ref": "#/$defs/clip" }, { "type": "null" }]
        }
      }
    }
  }
}
